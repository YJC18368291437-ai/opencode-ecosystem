{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "dpsk": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "setCacheKey": true
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 0.3,
            "output": 1.2,
            "cache_read": 0.006,
            "cache_write": 0.3
          }
        }
      }
    }
  },
  "model": "dpsk/deepseek-flash",
  "instructions": [
    "{env:HOME}/.config/opencode/memory/INDEX.md",
    "{env:HOME}/.config/opencode/memory/learning/known.md"
  ],
  "plugin": [
    "opencode-tavily",
    "opencode-handoff@0.5.0",
    "@ramtinj95/opencode-tokenscope"
  ],
  "permission": {
    "bash": {
      "tvly *": "allow"
    }
  }
}
